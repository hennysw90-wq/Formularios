rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Datos de la app Formularios anterior ────────────────────────────
    // Se conservan tal cual: la CdR no los lee ni los modifica (sus
    // colecciones llevan prefijo "cdr"), así que no se pierde nada.
    match /formularios/{id} {
      allow read, write: if true;
      match /respuestas/{respuestaId} {
        allow read, write: if true;
      }
    }

    // ── CdR · Diálogo de Desempeño ──────────────────────────────────────
    // Igual que en el resto de Henny, sin exigir sesión: la identidad y el
    // acceso salen del directorio compartido, no de Firebase Auth.
    match /cdrFormularios/{id}  { allow read, write: if true; }
    match /cdrAsignaciones/{id} { allow read, write: if true; }
    match /cdrCompromisos/{id}  { allow read, write: if true; }

    // Una CdR enviada queda bloqueada: no se puede editar ni borrar. Lo único
    // que se permite sobre una enviada es anularla o restaurarla (los tres
    // campos "anulada*"), para que una prueba deje de contar sin perderse.
    match /cdrEvaluaciones/{id} {
      allow read, create: if true;
      allow update: if resource.data.estado != 'enviada'
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['anulada', 'anuladaMotivo', 'anuladaFecha']);
      allow delete: if false;
    }
  }
}
