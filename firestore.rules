rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Formularios creados desde el panel (login propio, sin Firebase Auth).
    // El link público del QR LEE el formulario sin haber iniciado sesión,
    // así que la lectura no puede requerir autenticación.
    match /formularios/{id} {
      allow read, write: if true;

      // Respuestas enviadas desde el QR: las escribe gente que no tiene
      // sesión, por eso también quedan abiertas.
      match /respuestas/{respuestaId} {
        allow read, write: if true;
      }
    }
  }
}
